{
  "name": "ame-errante",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4173",
    "dev:lan": "next dev --hostname 0.0.0.0 --port 4173",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 4173",
    "start:lan": "next start --hostname 0.0.0.0 --port 4173",
    "check": "node scripts/check.mjs",
    "test": "node ../scripts/platform-cli.mjs test",
    "test:backend": "node ../scripts/platform-cli.mjs test",
    "db:init": "node --env-file-if-exists=.env.local scripts/database.mjs init",
    "db:backup": "node --env-file-if-exists=.env.local scripts/database.mjs backup",
    "admin:create": "node --env-file-if-exists=.env.local scripts/database.mjs admin"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "three": "0.186.1",
    "@ames/core": "workspace:*"
  }
}
