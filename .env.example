# SQLite needs a persistent disk and one application instance.
DATABASE_PATH=./data/ame-errante.sqlite
# Production cookies are secure by default. Only use false for local HTTP tests.
# COOKIE_SECURE=false
# Behind an HTTPS reverse proxy, set the public origin without a trailing path.
# APP_ORIGIN=https://association.example

# Official WhatsApp Cloud API. Keep these secrets on the server only.
# Get the supported API version from your Meta app dashboard (format vXX.0).
# WHATSAPP_API_VERSION=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEAM_TEMPLATE=ame_errante_nouvelle_demande
# WHATSAPP_RECEIPT_TEMPLATE=ame_errante_accuse_reception
# WHATSAPP_LANGUAGE=fr
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=

# Use a protected external disk / network folder for off-machine backups.
# BACKUP_DIRECTORY=D:/sauvegardes-ame-errante
# Disable background services for an isolated test or restore inspection.
# DISABLE_MAINTENANCE=true
